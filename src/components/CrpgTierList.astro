---
import LuminanceImage from "@/components/LuminanceImage.astro";
import type { ImageMetadata } from "astro";
import Plus from "phosphor-astro/Plus.astro";
import Minus from "phosphor-astro/Minus.astro";

type CrpgTag =
  | "Story"
  | "Characters"
  | "Romance"
  | "Agency"
  | "Combat"
  | "Quests"
  | "Build Diversity"
  | "Exploration"
  | "Atmosphere"
  | "Presentation"
  | "Replayability";

interface Props {
  games: Array<{
    image: ImageMetadata;
    title: string;
    score: number;
    pros?: Array<CrpgTag>;
    cons?: Array<CrpgTag>;
    notes?: string;
  }>;
}

const { games } = Astro.props;
---

<ol class="not-prose space-y-4 *:grid *:grid-cols-[minmax(0,20%)_auto] *:gap-2">
  {
    games.map((game) => (
      <li class="relative">
        <span class="absolute top-0 left-0 z-1 inline-block border border-body bg-background px-1.5 font-heading text-lg font-bold text-body outline-4 outline-background">
          {game.score.toFixed(1)}
        </span>

        <LuminanceImage src={game.image} width={400} alt={`Cover art for ${game.title}`} />

        <div class="space-y-2">
          <span class="block font-heading text-xl text-foreground">{game.title}</span>

          {(game.pros?.length || game.cons?.length) && (
            <ul class="ui-text flex flex-wrap gap-x-1.5 gap-y-1 text-xs leading-0 text-nowrap whitespace-nowrap *:flex *:h-5 *:items-center *:gap-0.75 *:border *:py-0.5 *:pr-1.75 *:pl-1.5">
              {game.pros?.map((tag) => (
                <li class="border-body text-body *:shrink-0">
                  <Plus class="size-3" aria-label="Pro" />
                  {tag}
                </li>
              ))}
              {game.cons?.map((tag) => (
                <li class="border-muted text-muted *:shrink-0">
                  <Minus class="size-3" aria-label="Con" />
                  {tag}
                </li>
              ))}
            </ul>
          )}

          {game.notes && <p class="text-base">{game.notes}</p>}
        </div>
      </li>
    ))
  }
</ol>
