---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;

const mask = (await getImage({ src, width: 1440, format: "webp" })).src;
---

<figure class={className}>
  <div
    class="luminance-mask bg-foreground"
    style={`--mask: url(${mask}); --mask-size: 100% 100%; aspect-ratio: ${src.width} / ${src.height}`}
    role="img"
    aria-label={alt}
  >
  </div>
</figure>
