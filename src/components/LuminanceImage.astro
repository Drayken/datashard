---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
}

const { src, alt, class: className, width = 1440 } = Astro.props;

const mask = (await getImage({ src, width, format: "webp" })).src;
---

<figure class={className}>
  <div
    class="luminance-mask bg-foreground"
    style={`--mask: url(${mask}); --mask-size: 100% 100%; aspect-ratio: ${src.width} / ${src.height}`}
    role="img"
    aria-label={alt}>
  </div>
</figure>
