---
import { SITE_TITLE } from "@/lib/consts";
import HeaderLink from "@/components/HeaderLink.astro";
---

<header class="px-12 font-ui uppercase">
  <nav>
    <ul
      class="flex h-18 items-center gap-8 *:grid *:h-full *:shrink-0 *:place-items-center *:hover:text-accent *:focus-visible:text-accent">
      <a href="/" class="mr-auto pr-2 text-xl tracking-[0.3em]">{SITE_TITLE}</a>
      <HeaderLink href="/echoes" class="ui-text px-2">ECHOES</HeaderLink>
      <HeaderLink href="/about" class="ui-text px-2">ABOUT</HeaderLink>
    </ul>
  </nav>
</header>
