---
import { SITE_TITLE } from "@/lib/consts";
import HeaderLink from "@/components/HeaderLink.astro";
---

<header class="border-b px-12 font-ui uppercase">
  <nav>
    <ul class="flex h-18 items-center gap-8 *:grid *:h-full *:shrink-0 *:place-items-center">
      <a href="/" class="mr-auto pr-2 text-2xl tracking-[0.3em]">{SITE_TITLE}</a>
      <HeaderLink href="/echoes" class="px-2">ECHOES</HeaderLink>
      <HeaderLink href="/about" class="px-2">ABOUT</HeaderLink>
    </ul>
  </nav>
</header>
