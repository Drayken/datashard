---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Shell from "@/layouts/Shell.astro";

type Props = CollectionEntry<"echoes">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const heroMask = (await getImage({ src: heroImage, width: 1020, format: "webp" })).src;

// https://github.com/tailwindlabs/tailwindcss-typography
---

<Shell title={title} description={description} image={heroImage}>
  <main
    class="mx-auto prose w-full grow pt-8 pb-16 prose-datashard lg:prose-lg prose-headings:font-normal prose-h1:mb-1 prose-pre:rounded-none">
    <div
      class="luminance-mask not-prose mb-8 h-80 w-full bg-foreground"
      style={`--mask: url(${heroMask}); --mask-size: cover`}
      aria-label="Article Cover Image">
    </div>
    <h1>{title}</h1>
    <small>
      <FormattedDate date={pubDate} />{
        updatedDate && (
          <>
            {" "}
            &bull; UPDATED <FormattedDate date={updatedDate} />
          </>
        )
      }
    </small>
    <hr class="my-8!" />
    <slot />
  </main>
</Shell>
