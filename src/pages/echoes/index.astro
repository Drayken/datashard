---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Shell from "@/layouts/Shell.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";

const echoes = (await getCollection("echoes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = echoes;
---

<Shell>
  <main class="flex flex-col gap-8 px-12 py-16">
    <h1 class="sr-only">Latest Echoes</h1>
    {
      featured && (
        <section class="grid grid-cols-2">
          <div>
            <span class="ui-text text-muted">
              <FormattedDate date={featured.data.pubDate} />
            </span>
            <h2 class="mb-8 max-w-3xl font-heading text-7xl leading-tight">{featured.data.title}</h2>
            <p class="mb-16 max-w-md font-ui text-lg text-muted">{featured.data.description}</p>
            <a
              href={`/echoes/${featured.id}/`}
              class="group ui-text inline-flex items-center gap-2 border-b py-1 text-lg transition-all duration-150 hover:border-transparent hover:bg-accent hover:text-background focus-visible:border-transparent focus-visible:bg-accent focus-visible:text-background">
              READ ECHO
              <ArrowUpRight class="-mb-0.5 size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-none motion-reduce:group-focus-visible:translate-none" />
            </a>
          </div>
          <Image
            src={featured.data.heroImage}
            width={1020}
            height={510}
            alt=""
            class="h-0 min-h-full w-full object-cover object-center"
          />
        </section>
      )
    }
    <div role="separator" class="bg-dotted h-16 w-full"></div>
    <section>
      <ul class="border-y">
        {
          rest.map((echo) => (
            <li class="grid grid-cols-2 py-8 not-last:border-b">
              <div>
                <a
                  href={`/echoes/${echo.id}/`}
                  class="mb-2 font-heading text-3xl hover:underline focus-visible:underline">
                  <h3>{echo.data.title}</h3>
                </a>
                <span class="ui-text text-muted">
                  <FormattedDate date={echo.data.pubDate} />
                </span>
              </div>
              <Image
                src={echo.data.heroImage}
                width={360}
                height={360}
                alt=""
                class="aspect-square h-0 min-h-full w-auto object-cover object-center"
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Shell>
