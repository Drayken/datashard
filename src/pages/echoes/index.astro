---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Shell from "@/layouts/Shell.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";

const echoes = (await getCollection("echoes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = echoes;

const featuredMask = featured
  ? (await getImage({ src: featured.data.heroImage, width: 1024, format: "webp" })).src
  : undefined;

const restMasks = await Promise.all(
  rest.map(async (echo) => ({
    echo,
    mask: (await getImage({ src: echo.data.heroImage, width: 1024, format: "webp" })).src,
  }))
);
---

<Shell>
  <main class="flex flex-col gap-8 px-12 py-16">
    <h1 class="sr-only">Latest Echoes</h1>
    {
      featured && (
        <section class="grid grid-cols-2">
          <div>
            <span class="font-ui text-muted">
              <FormattedDate date={featured.data.pubDate} />
              {featured.data.updatedDate && (
                <>
                  {" "}
                  &bull; UPDATED <FormattedDate date={featured.data.updatedDate} />
                </>
              )}
            </span>
            <h2 class="mb-8 max-w-3xl font-heading text-7xl leading-tight">{featured.data.title}</h2>
            <p class="mb-16 max-w-md font-ui text-lg">{featured.data.description}</p>
            <a
              href={`/echoes/${featured.id}/`}
              class="group ui-text inline-flex items-center gap-2 border-b py-1 text-lg text-foreground transition-all duration-150 hover:border-transparent hover:bg-accent hover:text-background focus-visible:border-transparent focus-visible:bg-accent focus-visible:text-background">
              READ ECHO
              <ArrowUpRight class="-mb-0.5 size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-none motion-reduce:group-focus-visible:translate-none" />
            </a>
          </div>
          <div
            class="luminance-mask h-0 min-h-full w-full bg-foreground"
            style={`--mask: url(${featuredMask})`}
            aria-hidden
          />
        </section>
      )
    }
    <div role="separator" class="bg-dotted h-16 w-full"></div>
    <section>
      <ul class="border-y">
        {
          restMasks.map(({ echo, mask }) => (
            <li class="relative grid grid-cols-[auto_1fr] gap-8 not-last:border-b">
              <div
                class="luminance-mask aspect-square h-0 min-h-full w-auto bg-foreground"
                style={`--mask: url(${mask}); --mask-size: contain`}
                aria-hidden
              />
              <div class="py-8">
                <h3 class="mb-2">
                  <a href={`/echoes/${echo.id}/`} class="font-heading text-3xl hover:underline focus-visible:underline">
                    {echo.data.title}
                  </a>
                </h3>
                <span class="ui-text text-muted">
                  <FormattedDate date={echo.data.pubDate} />
                  {echo.data.updatedDate && (
                    <>
                      {" "}
                      &bull; UPDATED <FormattedDate date={echo.data.updatedDate} />
                    </>
                  )}
                </span>
              </div>
              <div
                class="luminance-mask pointer-events-none absolute inset-0 bg-foreground opacity-5"
                style={`--mask: url(${mask}); --mask-size: cover`}
                aria-hidden
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Shell>
