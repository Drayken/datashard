---
import Shell from "@/layouts/Shell.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";
---

<Shell>
  <main class="relative flex grow flex-col justify-center px-12 py-16">
    <div class="z-1">
      <h1 class="mb-8 max-w-4xl font-heading text-7xl font-normal">Fragments of the Digital Frontier</h1>
      <p class="ui-text mb-16 max-w-md text-lg">AN ARCHIVE BY @KGDRAYKEN</p>
      <a href="/" class="ui-text flex items-center gap-2 text-lg">
        READ THE LATEST <ArrowUpRight class="-mb-0.5 size-4" />
      </a>
    </div>

    <!-- HERO ART -->
    <div class="hero-mask hero-mask-base pointer-events-none absolute inset-0 bg-foreground opacity-30" aria-hidden>
    </div>
    <div class="hero-mask hero-mask-accent pointer-events-none absolute inset-0 bg-accent" aria-hidden></div>
    <div
      aria-hidden
      class="corner-border ui-text pointer-events-none absolute top-[30%] right-8 w-fit -translate-y-1/2 px-4 py-3 opacity-30 select-none">
      ORDER<br /> IS A MOMENT.<br /> ENTROPY<br /> IS THE STORY.
    </div>
  </main>
</Shell>
