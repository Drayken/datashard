---
import { getCollection } from "astro:content";
import Shell from "@/layouts/Shell.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";

const latest = (await getCollection("echoes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestHref = latest ? `/echoes/${latest.id}/` : "/echoes/";
---

<Shell>
  <main class="relative flex grow flex-col justify-center px-6 py-16 lg:px-12">
    <div class="z-1">
      <h1
        class="page-enter page-enter--0 mb-8 max-w-4xl bg-background font-heading text-[clamp(2rem,5vw,5rem)] leading-tight">
        Fragments of the Digital Frontier
      </h1>
      <p class="page-enter page-enter--1 mb-16 max-w-md bg-background font-ui text-lg text-muted">
        Editorial Entropy by @KGDrayken
      </p>
      <a
        href={latestHref}
        class="group ui-text page-enter page-enter--2 inline-flex items-center gap-2 border-b bg-background py-1 text-lg text-foreground transition-colors duration-150 hover:border-transparent hover:bg-accent hover:text-background focus-visible:border-transparent focus-visible:bg-accent focus-visible:text-background">
        READ LATEST ECHO
        <ArrowUpRight
          class="-mb-0.5 size-4 transition-transform duration-150 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-focus-visible:translate-none fine-hover:group-hover:translate-x-0.5 fine-hover:group-hover:-translate-y-0.5 motion-reduce:fine-hover:group-hover:translate-none"
        />
      </a>
    </div>

    <!-- HERO ART -->
    <div class="page-enter-hero pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="hero-mask hero-mask-base absolute inset-0 bg-foreground opacity-30"></div>
      <div class="hero-accent-flicker absolute inset-0">
        <div class="hero-mask hero-mask-accent absolute inset-0 bg-accent"></div>
      </div>
    </div>
    <div
      aria-hidden="true"
      class="corner-border ui-text page-enter-fade page-enter--3 pointer-events-none absolute top-[30%] right-8 w-fit -translate-y-1/2 px-4 py-3 opacity-30 select-none">
      ORDER<br /> IS A MOMENT.<br /> ENTROPY<br /> IS THE STORY.
    </div>
  </main>
</Shell>
