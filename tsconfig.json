{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleDetection": "force",
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true
  }
}
